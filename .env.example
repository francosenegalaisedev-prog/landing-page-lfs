# Variables lues par Astro au moment du build (copier en .env pour le développement local).

# Clé de site Cloudflare Turnstile (anti-spam du formulaire). Vide : pas de widget.
# Si vous la renseignez, renseignez aussi TURNSTILE_SECRET_KEY côté Cloudflare Pages.
PUBLIC_TURNSTILE_SITE_KEY=

# true : les formulaires simulent l'envoi, sans serveur (aperçu, maquette). Laisser vide en production.
PUBLIC_DEMO=
