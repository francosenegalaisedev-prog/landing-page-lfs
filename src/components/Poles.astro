---
/**
 * Nos expertises : quatre onglets (motif ARIA « tabs ») et notre méthode.
 * Tous les panneaux sont dans le HTML, seul le premier est visible au chargement ;
 * scripts/poles.ts gère les clics, le clavier et les liens « pôle » du reste de la page (data-voir-pole).
 */
import { poles } from '../data/poles';
import Icone from './Icone.astro';
---

<section id="expertises" aria-labelledby="t-expertises" class="gouttiere section-y fond-points bg-noir text-creme">
	<div class="mx-auto flex max-w-page flex-col gap-8">
		<div class="flex flex-col items-start gap-4">
			<p class="surtitre text-miel">Nos expertises</p>
			<h2 id="t-expertises" class="titre-section text-creme">
				Tous nos métiers, <em class="accent tracking-normal text-ambre">sous un même toit.</em>
			</h2>
			<p class="max-w-[640px] text-[17px] leading-[1.6] text-pretty text-texte-2">
				Quatre pôles partagés par nos filiales, et mobilisés sur les projets menés avec nos partenaires.
			</p>
		</div>

		<div
			role="tablist"
			aria-label="Nos expertises"
			class="grid grid-cols-4 gap-2.5 max-[861px]:grid-cols-2 max-[421px]:grid-cols-1"
		>
			{poles.map((pole, index) => (
				<button
					type="button"
					role="tab"
					id={`onglet-${pole.id}`}
					aria-selected={index === 0 ? 'true' : 'false'}
					aria-controls={`panneau-${pole.id}`}
					tabindex={index === 0 ? '0' : '-1'}
					data-onglet={pole.id}
					data-pole={pole.id}
					class="group flex min-h-16 min-w-0 cursor-pointer items-center gap-3 rounded-[14px] border border-trait-1 bg-surface-2 px-3.5 py-3 text-left text-creme transition-colors duration-200 hover:not-aria-selected:border-trait-4 aria-selected:border-creme aria-selected:bg-creme aria-selected:text-noir"
				>
					<span
						aria-hidden="true"
						class="flex size-10 flex-none items-center justify-center rounded-[10px] bg-(--pole-fond) text-(--pole) group-aria-selected:bg-noir max-[1181px]:hidden"
					>
						<Icone nom={pole.icone} class="size-[22px]" />
					</span>
					<span class="flex min-w-0 flex-col">
						<span class="text-[12px] leading-[1.3] font-semibold tracking-[0.12em] text-texte-4 group-aria-selected:text-bronze">{pole.numero}</span>
						<span class="font-titre text-[17px] leading-[1.2] font-semibold text-balance">{pole.nom}</span>
					</span>
				</button>
			))}
		</div>

		{poles.map((pole, index) => (
			<div
				role="tabpanel"
				id={`panneau-${pole.id}`}
				aria-labelledby={`onglet-${pole.id}`}
				tabindex="0"
				hidden={index !== 0}
				data-panneau={pole.id}
				data-pole={pole.id}
				class="flex flex-col items-start gap-6 rounded-[22px] border border-t-[3px] border-trait-1 border-t-(--pole) bg-surface-1 p-[clamp(24px,3.4vw,48px)]"
			>
				{pole.sousPoles ? (
					<div class="grid w-full grid-cols-2 gap-8 max-[761px]:grid-cols-1">
						{pole.sousPoles.map((bloc) => (
							<div data-pole={bloc.poleCouleur ?? pole.id} class="flex flex-col items-start gap-3.5">
								<p class="text-[12.5px] font-semibold tracking-[0.14em] text-(--pole) uppercase">{bloc.surtitre}</p>
								<h3 class="max-w-[840px] font-titre text-[clamp(26px,2.8vw,38px)] leading-[1.06] font-semibold tracking-[-0.025em] text-balance text-creme">
									{bloc.titre}<em class="accent tracking-normal text-(--pole)">{bloc.titreAccent}</em>
								</h3>
								<p class="max-w-[680px] text-[16.5px] leading-[1.6] text-pretty text-texte-2">{bloc.texte}</p>
							</div>
						))}
					</div>
				) : (
					<div class="flex flex-col items-start gap-[18px]">
						<p class="text-[12.5px] font-semibold tracking-[0.14em] text-(--pole) uppercase">{pole.surtitre}</p>
						<h3 class="max-w-[840px] font-titre text-[clamp(28px,3vw,42px)] leading-[1.06] font-semibold tracking-[-0.025em] text-balance text-creme">
							{pole.titre}<em class="accent tracking-normal text-(--pole)">{pole.titreAccent}</em>
						</h3>
						<p class="max-w-[680px] text-[16.5px] leading-[1.6] text-pretty text-texte-2">{pole.texte}</p>
					</div>
				)}

				<ul aria-label={`Les services du ${pole.surtitre.toLowerCase()}`} class="flex flex-wrap gap-2">
					{pole.services.map((service) => (
						<li class="rounded-full border border-(--pole-trait) px-3.5 py-[7px] text-[14.5px] font-medium text-creme">{service}</li>
					))}
				</ul>
			</div>
		))}

		<div id="methode" class="mt-[clamp(16px,2.4vw,32px)] flex flex-col gap-3.5 border-t border-trait-1 pt-[clamp(32px,4vw,56px)]">
			<div class="flex flex-col items-start gap-3.5">
				<p class="text-[12.5px] font-semibold tracking-[0.14em] text-miel uppercase">Notre méthode</p>
				<h3 class="max-w-[1000px] font-titre text-[clamp(30px,3.6vw,52px)] leading-[1.05] font-bold tracking-[-0.035em] text-balance text-creme">
					Écouter. <em class="accent tracking-[-0.01em] text-ambre">Analyser.</em> Concevoir. <em class="accent tracking-[-0.01em] text-ambre">Produire.</em> Déployer. <em class="accent tracking-[-0.01em] text-ambre">Mesurer.</em>
				</h3>
				<p class="max-w-[760px] text-[clamp(17px,1.4vw,19px)] leading-[1.6] text-pretty text-texte-2">
					Nous analysons nous-mêmes chaque situation.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	import '../scripts/poles.ts';
</script>
