---
import '../styles/global.css';
import { site } from '../config';

interface Props {
	titre: string;
	description: string;
	/** Données structurées (JSON-LD) ajoutées dans le <head>. */
	donneesStructurees?: Record<string, unknown>;
}

const { titre, description, donneesStructurees } = Astro.props;
const base = Astro.site ?? new URL('https://lafrancosenegalaise.com');
const urlCanonique = new URL(Astro.url.pathname, base).href;
const imagePartage = new URL('/og-image.jpg', base).href;
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titre}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={urlCanonique} />
		<meta name="theme-color" content="#16130f" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content={site.nom} />
		<meta property="og:title" content={titre} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={urlCanonique} />
		<meta property="og:image" content={imagePartage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&family=Cormorant+Garamond:ital,wght@1,500;1,600&display=swap"
		/>

		{donneesStructurees && <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />}
	</head>
	<body class="bg-noir font-sans text-[17px] leading-[1.6] text-creme">
		<slot />
	</body>
</html>
