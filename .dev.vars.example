# Variables des fonctions Cloudflare Pages (dossier functions/), pour les tester en local.
# Copier ce fichier en .dev.vars (déjà ignoré par Git), puis remplir les valeurs.
# Ne jamais enregistrer de vraie clé dans ce fichier d'exemple.
# En production, ces mêmes noms se saisissent dans Cloudflare Pages > Settings > Variables and Secrets.

# Clé API Brevo (SECRÈTE) : Brevo > SMTP et API > Clés API. Sert à envoyer l'e-mail de contact et l'inscription newsletter.
BREVO_API_KEY=

# Adresse expéditrice, déjà ajoutée et authentifiée chez Brevo (Expéditeurs, domaines et IP dédiées). Obligatoire pour envoyer.
SENDER_EMAIL=

# Nom affiché de l'expéditeur dans la boîte de réception (facultatif ; défaut : « Site La Franco-Sénégalaise »).
SENDER_NAME=

# Boîte qui reçoit les demandes du formulaire de contact (facultatif ; défaut : lafrancosenegalaise@gmail.com).
CONTACT_TO=

# Numéro de la liste Brevo « Newsletter » (nombre entier) : Brevo > Contacts > Listes. Nécessaire pour la newsletter.
BREVO_LIST_ID=

# Numéro du modèle d'e-mail de confirmation (double opt-in), qui doit contenir le lien {{ params.DOIurl }} : Brevo > Marketing > Modèles d'e-mail.
BREVO_DOI_TEMPLATE_ID=

# Adresse publique du site, avec https:// (ex. https://votre-domaine.com) : page où revient le visiteur après avoir confirmé.
SITE_URL=

# Clé SECRÈTE Cloudflare Turnstile (anti-spam). Vide : pas de vérification.
# À renseigner avec PUBLIC_TURNSTILE_SITE_KEY (clé de site, lue au build, voir .env.example) : l'une sans l'autre bloque tous les envois.
TURNSTILE_SECRET_KEY=

# --- Tests uniquement : ne JAMAIS définir en production (ils redirigent les appels vers un faux serveur) ---
# Adresse d'une API Brevo simulée (ex. http://127.0.0.1:8799/v3). Vide : vraie API Brevo.
# BREVO_API_URL=
# Adresse d'un faux service de vérification Turnstile. Vide : vrai service Cloudflare.
# TURNSTILE_VERIFY_URL=
