# Variables d'environnement des fonctions Vercel (dossier api/), pour le développement local.
# Copier ce fichier en .env.local (déjà ignoré par Git), puis remplir les valeurs.
# Ne jamais enregistrer de vraie clé dans ce fichier d'exemple.
# En production, ces mêmes noms se saisissent dans Vercel > Settings > Environment Variables.

# Clé API Brevo v3 (SECRÈTE, commence par xkeysib-) : Brevo > SMTP et API > Clés API. Sert à envoyer l'e-mail de contact et l'inscription newsletter.
BREVO_API_KEY=

# Adresse expéditrice, déjà ajoutée et authentifiée chez Brevo (Expéditeurs, domaines et IP dédiées). Obligatoire pour envoyer.
SENDER_EMAIL=

# Nom affiché de l'expéditeur dans la boîte de réception (facultatif ; défaut : « Site La Franco-Sénégalaise »).
SENDER_NAME=

# Boîte qui reçoit les demandes du formulaire de contact (facultatif ; défaut : lafrancosenegalaise@gmail.com).
CONTACT_TO=

# Numéro de la liste Brevo « Newsletter » (nombre entier) : Brevo > Contacts > Listes. Nécessaire pour la newsletter.
BREVO_LIST_ID=

# Numéro du modèle d'e-mail de confirmation (double opt-in), qui doit contenir le lien {{ params.DOIurl }} : Brevo > Marketing > Modèles d'e-mail.
BREVO_DOI_TEMPLATE_ID=

# Adresse publique du site, avec https:// (ex. https://lafrancosenegalaise.com) : page où revient le visiteur après avoir confirmé.
SITE_URL=

# Clé SECRÈTE Cloudflare Turnstile (anti-spam, facultatif). Vide : pas de vérification.
TURNSTILE_SECRET_KEY=
